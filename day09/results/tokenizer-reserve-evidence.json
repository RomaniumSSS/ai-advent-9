{
  "model": "deepseek/deepseek-v4-flash-0731",
  "tokenizer_source": "https://huggingface.co/deepseek-ai/DeepSeek-V4-Flash-0731/raw/main/tokenizer.json",
  "encoding_source": "https://huggingface.co/deepseek-ai/DeepSeek-V4-Flash-0731/raw/main/encoding/encoding_dsv4.py",
  "tokenizer_sha256": "8f9f37ca37fdc4f5fd36d5cf4d3b0e8392edb4e894fd10cc0d70b4957c8633cf",
  "model_type": "BPE",
  "normalizer": {
    "type": "Sequence",
    "normalizers": []
  },
  "pre_tokenizer": {
    "type": "Sequence",
    "pretokenizers": [
      {
        "type": "Split",
        "pattern": {
          "Regex": "\\p{N}{1,3}"
        },
        "behavior": "Isolated",
        "invert": false
      },
      {
        "type": "Split",
        "pattern": {
          "Regex": "[一-龥぀-ゟ゠-ヿ]+"
        },
        "behavior": "Isolated",
        "invert": false
      },
      {
        "type": "Split",
        "pattern": {
          "Regex": "[!\"#$%&'()*+,\\-./:;<=>?@\\[\\\\\\]^_`{|}~][A-Za-z]+|[^\r\n\\p{L}\\p{P}\\p{S}]?[\\p{L}\\p{M}]+| ?[\\p{P}\\p{S}]+[\r\n]*|\\s*[\r\n]+|\\s+(?!\\S)|\\s+"
        },
        "behavior": "Isolated",
        "invert": false
      },
      {
        "type": "ByteLevel",
        "add_prefix_space": false,
        "trim_offsets": true,
        "use_regex": false
      }
    ]
  },
  "reserve_rule": "UTF-8 bytes of text + 1024*(number of messages + 1); output uses max_tokens; not actual API usage"
}
